        ".write": "auth!=null&&auth.uid===$uid&&((!data.exists()&&newData.child('n').val()===1&&newData.child('w').val()===now)||(data.exists()&&now-data.child('w').val()>=600000&&newData.child('n').val()===1&&newData.child('w').val()===now)||(data.exists()&&now-data.child('w').val()<600000&&newData.child('w').val()===data.child('w').val()&&newData.child('n').val()===data.child('n').val()+1&&newData.child('n').val()<=3))",
        ".validate": "newData.hasChildren(['w','n'])",
        "w": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": "newData.isNumber()&&newData.val()>=1&&newData.val()<=3"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "games": {
      "$gid": {
        ".read": "auth!=null&&(root.child('members/'+$gid+'/'+auth.uid).val()===true||(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val()))",
        ".write": "auth!=null&&((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists()||root.child('gamePerm/'+$gid+'/'+auth.uid).exists())&&(!newData.exists()||newData.child('by').val()===auth.uid)",
        ".validate": "newData.hasChildren(['t','by','s'])",
        "t": {
          ".validate": "newData.isString()&&newData.val().length<=4"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "s": {
          ".validate": "newData.val()==='wait'||newData.val()==='open'||newData.val()==='run'||newData.val()==='end'"
        },
        "min": {
          ".validate": "newData.isNumber()&&newData.val()>=0"
        },
        "cap": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isString()&&newData.val().length<=1500"
        },
        "players": {
          "$u": {
            ".write": "auth!=null&&auth.uid===$u&&root.child('games/'+$gid+'/s').val()==='open'&&root.child('members/'+$gid+'/'+auth.uid).val()===true&&!data.exists()&&newData.child('bet').val()>=root.child('games/'+$gid+'/min').val()&&(auth.uid===root.child('games/'+$gid+'/by').val()||(root.child('wallets/'+auth.uid+'/bal').val()-newData.parent().parent().parent().parent().child('wallets').child(auth.uid).child('bal').val()>=newData.child('bet').val()))",
            ".validate": "newData.hasChild('bet')",
            "bet": {
              ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=100000000"
            },
            "pick": {
              ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=8"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "media": {
      "$gid": {
        ".read": "auth!=null&&(root.child('members/'+$gid+'/'+auth.uid).exists()||(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val()))",
        ".write": "auth!=null&&!newData.exists()&&((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists())",
        "$mid": {
          ".write": "auth!=null&&!newData.exists()&&((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists()||root.child('messages/'+$gid+'/'+$mid+'/from').val()===auth.uid)",
          "$n": {
            ".write": "auth!=null&&!data.exists()&&root.child('members/'+$gid+'/'+auth.uid).val()===true&&!root.child('banned/'+auth.uid).exists()",
            ".validate": "newData.isString()&&newData.val().length<=400000&&$n.matches(/^[0-9]{1,2}$/)"
          }
        }
      }
    }
  }
}