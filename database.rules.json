          ".validate": "newData.isBoolean()"
        },
        "desc": {
          ".write": "auth!=null&&((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists())",
          ".validate": "newData.isString()&&newData.val().length<=300"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groupAdmins": {
      "$gid": {
        ".read": "auth!=null",
        "$uid": {
          ".write": "auth!=null&&(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())"
        }
      }
    },
    "members": {
      "$gid": {
        ".read": "auth!=null&&(root.child('members/'+$gid+'/'+auth.uid).val()===true||((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists()))",
        "$uid": {
          ".read": "auth.uid===$uid",
          ".write": "auth!=null&&(((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())&&!(!newData.exists()&&$uid===root.child('config/emperorUid').val()&&auth.uid!==root.child('config/emperorUid').val()))||(auth.uid===$uid&&!data.exists()&&newData.val()===true&&!root.child('banned/'+auth.uid).exists()&&root.child('groups/'+$gid).exists()&&root.child('profiles/'+auth.uid).exists()&&(root.child('groups/'+$gid+'/kind').val()!=='main'||root.child('refCodes/'+root.child('refClaims/'+auth.uid).val()+'/g').val()===$gid))||(auth.uid===$uid&&!data.exists()&&newData.val()==='v'&&!root.child('banned/'+auth.uid).exists()&&root.child('groups/'+$gid+'/kind').val()==='main'&&(root.child('wallets/'+auth.uid+'/bal').val()-newData.parent().parent().parent().child('wallets').child(auth.uid).child('bal').val()>=10000))||(auth.uid===$uid&&data.val()==='v'&&!newData.exists())||(!newData.exists()&&root.child('groupAdmins/'+$gid+'/'+auth.uid).exists()&&!(root.child('roles/'+$uid).val()==='dev'||$uid===root.child('config/emperorUid').val())))",
          ".validate": "newData.val()===true||newData.val()==='v'"
        }
      }
    },
    "messages": {
      "$gid": {
        ".read": "auth!=null&&(root.child('members/'+$gid+'/'+auth.uid).exists()||(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val()))",
        ".write": "auth!=null&&(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())&&!newData.exists()",
        "$mid": {
          ".write": "auth!=null&&((!data.exists()&&newData.child('from').val()===auth.uid&&root.child('members/'+$gid+'/'+auth.uid).exists()&&!root.child('banned/'+auth.uid).exists()&&(!root.child('bans/'+$gid+'/'+auth.uid).exists()||root.child('bans/'+$gid+'/'+auth.uid).val()<now)&&(!(newData.child('type').val()==='sys')||(root.child('groups/'+$gid+'/kind').val()==='ads'||root.child('groups/'+$gid+'/kind').val()==='shop'||root.child('groups/'+$gid+'/kind').val()==='news')||(root.child('groups/'+$gid+'/kind').val()==='main'&&((newData.child('k').val()==='bot'&&newData.hasChild('f'))||(newData.child('k').val()==='visit'&&root.child('members/'+$gid+'/'+auth.uid).val()==='v')||(newData.child('type').val()==='sys'&&newData.child('k').val()==='welcome'&&root.child('groups/'+$gid+'/kind').val()==='main'&&newData.parent().parent().parent().child('welcomed').child($gid).child(auth.uid).exists()&&!root.child('welcomed/'+$gid+'/'+auth.uid).exists()))))&&((newData.child('type').val()==='sys'&&newData.child('k').val()==='welcome'&&root.child('groups/'+$gid+'/kind').val()==='main'&&newData.parent().parent().parent().child('welcomed').child($gid).child(auth.uid).exists()&&!root.child('welcomed/'+$gid+'/'+auth.uid).exists())||(root.child('groups/'+$gid+'/locked').val()!==true)||((root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||root.child('groupAdmins/'+$gid+'/'+auth.uid).exists())||(newData.child('type').val()==='sys'&&(root.child('groups/'+$gid+'/kind').val()==='ads'||root.child('groups/'+$gid+'/kind').val()==='shop'||root.child('groups/'+$gid+'/kind').val()==='news'))))&&(newData.child('type').val()!=='audio'||root.child('profiles/'+auth.uid+'/gender').val()==='m')||(data.exists()&&!newData.exists()&&(data.child('from').val()===auth.uid||(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())||(root.child('groupAdmins/'+$gid+'/'+auth.uid).exists()&&!(root.child('roles/'+data.child('from').val()).val()==='dev'||data.child('from').val()===root.child('config/emperorUid').val())))))",
          ".validate": "newData.hasChildren(['from','type','ts'])&&((newData.child('type').val()==='text'||newData.child('type').val()==='sys')&&newData.hasChild('text')||newData.child('type').val()==='image'&&newData.hasChild('img')||newData.child('type').val()==='sticker'&&newData.hasChild('sid')||newData.child('type').val()==='audio'&&newData.hasChild('au'))",
          "from": {
            ".validate": "newData.isString()"
          },
          "type": {
            ".validate": "newData.val()==='text'||newData.val()==='image'||newData.val()==='sticker'||newData.val()==='sys'||newData.val()==='audio'"
          },
          "au": {
            ".validate": "newData.isString()&&newData.val().beginsWith('data:audio/')&&newData.val().length<150000"
          },
          "dur": {
            ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=60"
          },
          "text": {
            ".write": "auth!=null&&data.parent().child('from').val()===auth.uid&&root.child('members/'+$gid+'/'+auth.uid).exists()&&!root.child('banned/'+auth.uid).exists()",
            ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=2000"
          },
          "edited": {
            ".write": "auth!=null&&data.parent().child('from').val()===auth.uid&&root.child('members/'+$gid+'/'+auth.uid).exists()&&!root.child('banned/'+auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          },
          "editedAt": {
            ".write": "auth!=null&&data.parent().child('from').val()===auth.uid&&root.child('members/'+$gid+'/'+auth.uid).exists()&&!root.child('banned/'+auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber()&&newData.val()<=now+5000"
          },
          "color": {
            ".validate": "newData.isString()&&newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "k": {
            ".validate": "newData.isString()&&newData.val().length<=12"
          },
          "d": {
            ".validate": "newData.isString()&&newData.val().length<=1400"
          },
          "vis": {
            ".validate": "newData.val()===true"
          },
          "f": {
            ".validate": "newData.isString()&&newData.val().length<=30"
          },
          "img": {
            ".validate": "newData.isString()&&(newData.val().beginsWith('data:image/jpeg;base64,')||newData.val().beginsWith('data:image/webp;base64,'))&&newData.val().length<60000"
          },
          "sid": {
            ".validate": "newData.isString()&&newData.val().length<=30"
          },
          "seen": {
            "$u": {
              ".write": "auth!=null&&auth.uid===$u&&root.child('members/'+$gid+'/'+auth.uid).exists()",
              ".validate": "newData.isNumber()"
            }
          },
          "reactions": {
            "$emo": {
              ".validate": "$emo.length<=16",
              "$u": {
                ".write": "auth!=null&&auth.uid===$u&&root.child('members/'+$gid+'/'+auth.uid).exists()&&!root.child('banned/'+auth.uid).exists()",
                ".validate": "newData.val()===true"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "locks": {
      "$k": {
        ".read": "auth!=null",
        ".write": "auth!=null&&!data.exists()&&(root.child('roles/'+auth.uid).val()==='dev'||auth.uid===root.child('config/emperorUid').val())"
      }
    },
    "dm": {
      "$a": {
        "$b": {
          ".read": "auth!=null&&(auth.uid===$a||auth.uid===$b)&&(root.child('roles/'+$a).val()==='dev'||$a===root.child('config/emperorUid').val())&&(root.child('roles/'+$b).val()==='dev'||$b===root.child('config/emperorUid').val())",
          "$mid": {
            ".write": "auth!=null&&(auth.uid===$a||auth.uid===$b)&&(root.child('roles/'+$a).val()==='dev'||$a===root.child('config/emperorUid').val())&&(root.child('roles/'+$b).val()==='dev'||$b===root.child('config/emperorUid').val())&&((!data.exists()&&newData.child('from').val()===auth.uid)||(data.exists()&&!newData.exists()&&data.child('from').val()===auth.uid))",
            ".validate": "newData.hasChildren(['from','text','ts'])&&newData.child('text').isString()&&newData.child('text').val().length<=2000&&newData.child('ts').isNumber()&&newData.child('ts').val()<=now+5000"
          }
        }
      }
    }
  }
}